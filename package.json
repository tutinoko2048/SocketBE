{
  "name": "socket-be",
  "version": "2.6.0-beta.0",
  "description": "This is a tool to connect with MinecraftBE via websocket easier.",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.mjs",
    "require": "./dist/index.js"
  },
  "scripts": {
    "test": "tsup --config test/tsup.config.ts && node --enable-source-maps test/dist/index.js",
    "lint": "eslint ./src && pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "@minecraft/server": "2.5.0",
    "@serenityjs/emitter": "^0.5.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/eslint": "^9.6.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tutinoko2048/SocketBE.git"
  },
  "keywords": [
    "minecraft",
    "websocket",
    "bedrock"
  ],
  "author": "tutinoko2048",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tutinoko2048/SocketBE/issues"
  },
  "homepage": "https://github.com/tutinoko2048/SocketBE#readme",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.28.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.28.0",
      "onFail": "error"
    }
  }
}
