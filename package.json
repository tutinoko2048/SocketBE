{
  "name": "socket-be",
  "version": "2.6.0",
  "description": "This is a tool to connect with MinecraftBE via websocket easier.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "tsdown -c ./test/tsdown.config.mts && node --enable-source-maps test/dist/index.mjs",
    "lint": "oxlint --type-aware --type-check",
    "build": "tsdown",
    "prepublishOnly": "pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "@minecraft/server": "2.5.0",
    "@serenityjs/emitter": "^0.5.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "oxlint": "^1.54.0",
    "oxlint-tsgolint": "^0.16.0",
    "tsdown": "^0.21.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tutinoko2048/SocketBE.git"
  },
  "keywords": [
    "minecraft",
    "websocket",
    "bedrock"
  ],
  "author": "tutinoko2048",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tutinoko2048/SocketBE/issues"
  },
  "homepage": "https://github.com/tutinoko2048/SocketBE#readme",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "error"
    }
  }
}
